# Retail POS System - Environment Configuration
# Copy this file to .env and adjust values as needed

# PostgreSQL Configuration
DB_NAME=retail_pos
DB_USER=pos
DB_PASSWORD=changeme_please_change_in_production
DB_PORT=5432

# Postgres (same as above)
POSTGRES_USER=pos
POSTGRES_PASSWORD=changeme_please_change_in_production
POSTGRES_DB=retail_pos

# Backend Configuration
BACKEND_IMAGE=retail-pos-backend:latest
FRONTEND_IMAGE=retail-pos-frontend:latest
POSTGRES_IMAGE=postgres:15-alpine

# Application Ports (for Docker environment)
BACKEND_PORT=8080
FRONTEND_PORT=80
DATABASE_PORT=5432

# Application
GIN_MODE=release
VITE_API_URL=/api

# Security (generate strong random values)
# JWT secrets are generated by backend on first run if not set
# To use custom secrets, set these in backend environment:
# JWT_SECRET=your-very-secure-secret-here
# JWT_REFRESH_SECRET=your-refresh-secret-here
