# Retail POS System - Production Environment Configuration
#
# This file is a REFERENCE, not a file the backend reads. Nothing in the
# application loads it, and podman-deploy.sh does not source a .env either.
#
# The one file that must exist on a production host is the secret file:
#
#   sudo mkdir -p /etc/retail-pos
#   sudo tee /etc/retail-pos/backend.env >/dev/null <<EOF
#   DB_PASSWORD=$(openssl rand -hex 24)
#   JWT_SECRET=$(openssl rand -hex 32)
#   JWT_SECRET_REFRESH=$(openssl rand -hex 32)
#   POSTGRES_PASSWORD=$DB_PASSWORD
#   POSTGRES_USER=pos
#   POSTGRES_DB=retail_pos
#   EOF
#   sudo chmod 600 /etc/retail-pos/backend.env
#
# POSTGRES_USER and POSTGRES_DB must be repeated alongside DB_USER and DB_NAME
# because the official postgres image only understands the POSTGRES_ names. It
# falls back to user and database both called "postgres" when they are absent,
# so a secret file carrying only the DB_ names leaves the backend trying to log
# in as a role that was never created. podman-deploy.sh passes DB_USER/DB_NAME
# to the database container as POSTGRES_USER/POSTGRES_DB; docker-compose.yml
# and deploy/quadlet/ rely on the secret file supplying both spellings.
#
# podman-deploy.sh sources that file and hands it to the backend container with
# `podman run --env-file`; docker-compose.yml passes it as `env_file`. Either way
# the secrets stay out of argv and the process table, but they remain readable via
# `podman inspect` / `docker inspect` to anyone with container access. The file
# must stay mode 600, and the host is the trust boundary.
#
# The backend REQUIRES JWT_SECRET and panics at startup without it - it does not
# generate one on first run.
#
# Override the file location with ENV_FILE if you keep secrets elsewhere.

# --- Required secrets (must live in the secret file) ---
DB_PASSWORD=
JWT_SECRET=
# Optional. When unset the backend reuses JWT_SECRET for refresh tokens, so
# the two token types can no longer be rotated independently. Recommended.
JWT_SECRET_REFRESH=

# --- Database ---
# DB_* are read by the backend. POSTGRES_* are read by the database container.
# Keep the two pairs in agreement.
DB_NAME=retail_pos
DB_USER=pos
DB_PORT=5432
POSTGRES_USER=pos
POSTGRES_DB=retail_pos
# Must equal DB_PASSWORD. Set it in the secret file rather than here; the
# official image also accepts POSTGRES_PASSWORD_FILE, but that path is not used
# because the secret file already exists.
POSTGRES_PASSWORD=

# --- Database TLS ---
# libpq sslmode for the backend's connection to PostgreSQL.
#
# The backend defaults to require in production, and refuses to start against a
# database that cannot do TLS. That default is correct and should stay, because
# it fails closed: a misconfigured deployment stops instead of quietly sending
# passwords and sales data in the clear.
#
# It also means this value must be set deliberately. The stock
# postgres:18-alpine image ships with ssl=off, and no deployment manifest in
# this repository mounts a certificate, so `require` will not start against it
# as shipped.
#
#   disable  - correct for a single-host deployment, where postgres is reachable
#              only over the pod's own network. Both podman-deploy.sh and
#              deploy/quadlet/ bind the host-side 5432 to 127.0.0.1 for exactly
#              this reason, and deploy/docker-compose.yml does not publish the
#              port at all, so no other host can open a connection. The backend
#              logs a startup warning when it sees this in production, so the
#              choice is recorded rather than silent.
#   require  - the only correct value once a certificate and key are mounted on
#              the database container. Nothing in this repository does that
#              yet; deploy/PRODUCTION-DEPLOYMENT.md has the manual procedure.
#              Use it as soon as the database is reachable off-host, including
#              any cloud deployment or multi-machine network.
#
# podman-deploy.sh reads SHOW ssl after startup. When this key is left unset it
# prefers `require`, but downgrades to `disable` with a warning if the database
# turns out to have ssl=off, so a fresh install starts without this line. An
# explicitly configured value is never downgraded: `require` against an ssl=off
# database fails instead. Setting it here records the decision either way.
DB_SSLMODE=disable

# --- Images ---
# Note the registry prefix. podman-deploy.sh builds these tags itself.
BACKEND_IMAGE=localhost/retail-pos-backend:latest
FRONTEND_IMAGE=localhost/retail-pos-frontend:latest
POSTGRES_IMAGE=docker.io/library/postgres:18-alpine

# --- Network ---
# Host port the frontend container is published on. nginx serves /health here,
# and it is the default value of CORS_ORIGIN.
#
# 8000, not 5173: 5173 is the Vite dev server's port, so a developer running
# `npm run dev` on this machine would collide with a production stack published
# there. 8000 needs no privileges (rootless podman cannot bind 80) and nothing
# else in the stack claims it — the backend holds 8080, postgres holds 5432,
# both on loopback.
HOST_FRONTEND_PORT=8000

# --- Application ---
# The browser origin the API accepts. MUST be a single origin: the CORS
# middleware receives it as a one-element list with no comma splitting, and the
# WebSocket upgrade check compares it as an exact string. A comma-separated
# list matches neither. This is read as CORS_ORIGIN by the backend.
#
# For a LAN client this is the URL the cashier types, so it must include :8000
# and match it exactly: http://192.168.1.50:8000, not http://192.168.1.50:8000/.
# A mismatch does not degrade — it 403s the WebSocket upgrade, so the dashboard
# badge reads "Offline" while the rest of the app loads.
CORS_ORIGIN=http://localhost:8000

# --- Set in the container by the script, not configurable here ---
# PORT=8080, ENV=production, LOG_LEVEL=info and GIN_MODE=release are passed
# explicitly by podman-deploy.sh.
#
# COOKIE_DOMAIN is intentionally not set: host-only is the correct default for the
# refresh_token cookie, and a broad value would share that token across subdomains.

# --- Set in the container by the script, but overridable here ---
# Secure flag on the 7-day HttpOnly refresh_token cookie, which the backend sets with
# secure=(COOKIE_SECURE == "true") in internal/user/auth_handler.go.
#
# Leave this false for the plain-HTTP deployment the script ships (the bundled nginx
# listens on 8081 with no ssl and is published on the LAN). A browser refuses to store
# a Secure cookie received over a non-localhost http origin, so setting it true without
# TLS in front of nginx silently drops the cookie at every remote register, and since
# the access token lives in sessionStorage the session dies at access-token expiry with
# no way back. Set it to true only once TLS is terminated in front of the frontend.
COOKIE_SECURE=false
