# Retail POS System - Development Environment Configuration
# Copy this file to .env and adjust values as needed

# JWT Secret (required) - Generate with: openssl rand -hex 32
# WARNING: Do not use this default value in production
JWT_SECRET=dev-jwt-secret-change-in-production

# JWT Refresh Secret (optional) - Separate secret for refresh tokens
# If not set, JWT_SECRET is used with a derivation for refresh tokens.
# For production, set this to a different value than JWT_SECRET.
# JWT_SECRET_REFRESH=

# Database connection settings
# Production: set sslmode=require or sslmode=verify-full
DB_HOST=localhost
DB_PORT=5433
DB_USER=pos
DB_PASSWORD=admin123
DB_NAME=retail_pos

# Login rate limit settings (default: 5 rpm, burst 5)
# Increase for development/testing to avoid 429 errors during E2E tests
LOGIN_RATE_LIMIT_RPM=60
LOGIN_RATE_LIMIT_BURST=60

# General API rate limit settings (default: 50 rps, burst 100)
# Applies to all API routes except login/refresh which have their own limiters
RATE_LIMIT_RPS=50
RATE_LIMIT_BURST=100

# Token refresh rate limit settings (default: 10 rpm, burst 10)
REFRESH_RATE_LIMIT_RPM=120
REFRESH_RATE_LIMIT_BURST=120

# Stock threshold settings
# Warning: stock below this level is flagged as "needs attention" (default: 10)
STOCK_WARNING_THRESHOLD=10
# Critical: stock below this level is flagged as "low stock" (default: 5)
STOCK_CRITICAL_THRESHOLD=5
# Cart hold TTL: hours a held cart remains valid before it expires (default: 24)
CART_HOLD_TTL_HOURS=24

# Reporting: debounce window (seconds) between SaleCreated-driven materialized
# view refreshes. Many sales within the window coalesce into a single refresh
# (default: 30)
REPORT_REFRESH_DEBOUNCE=30

# Logging settings
# ENV controls log format: "development" (text) vs "production" (JSON). Defaults to development.
ENV=development
# LOG_LEVEL: debug | info | warn | error (default: debug in development, info in production)
LOG_LEVEL=debug
# Frontend dev server port (Vite)
FRONTEND_PORT=5173
# Backend dev server port (Go)
BACKEND_PORT=9095
# Development database port (postgres-dev container)
DATABASE_PORT=5433