# Retail POS System - Development Environment Configuration
# Copy this file to .env and adjust values as needed

# JWT Secret (required) - Generate with: openssl rand -hex 32
# WARNING: Do not use this default value in production
JWT_SECRET=dev-jwt-secret-change-in-production

# JWT Refresh Secret (optional) - Separate secret for refresh tokens
# If not set, JWT_SECRET is used with a derivation for refresh tokens.
# For production, set this to a different value than JWT_SECRET.
# JWT_SECRET_REFRESH=

# Database connection settings
# DB_SSLMODE is the libpq sslmode used when the DSN is composed from the DB_*
# variables below. It defaults to disable in development and require in
# production, so it rarely needs setting here. Set it to disable only when the
# database is unreachable from outside the deployment network; the backend logs
# a warning at startup when it sees that in production.
# DB_SSLMODE=disable
DB_HOST=localhost
DB_PORT=5433
DB_USER=pos
DB_PASSWORD=admin123
DB_NAME=retail_pos

# Login rate limit settings (default: 30 rpm, burst 20 — a coarse per-IP flood
# guard sized for all registers behind one store NAT; brute-force protection is
# the separate per-account/per-IP failure counters in the backend, 5 and 10 per
# 15 minutes)
# Increase for development/testing to avoid 429 errors during E2E tests
LOGIN_RATE_LIMIT_RPM=60
LOGIN_RATE_LIMIT_BURST=60

# General API rate limit settings (default: 50 rps, burst 100)
# Applies to all API routes except login/refresh which have their own limiters
RATE_LIMIT_RPS=50
RATE_LIMIT_BURST=100

# Token refresh rate limit settings (default: 60 rpm, burst 60 — every register
# refreshes its 15-minute access token on that cadence, and they all refresh at
# once after a backend restart)
REFRESH_RATE_LIMIT_RPM=120
REFRESH_RATE_LIMIT_BURST=120

# Trusted reverse proxies (comma-separated CIDRs) whose X-Forwarded-For gin may
# trust when resolving the real client IP for rate limiting and audit logs.
# Default (unset): 127.0.0.1/32,::1/32 — correct for the bundled single-pod
# deployment where nginx shares the backend's network namespace. For a split
# deployment, set this to the nginx machine's IP/CIDR; requests from any peer
# outside this list have X-Forwarded-For ignored (spoof-proof, but they share
# one rate-limit bucket keyed on their own address).
# TRUSTED_PROXIES=127.0.0.1/32,::1/32

# Stock threshold settings
# Warning: stock below this level is flagged as "needs attention" (default: 10)
STOCK_WARNING_THRESHOLD=10
# Critical: stock below this level is flagged as "low stock" (default: 5)
STOCK_CRITICAL_THRESHOLD=5
# Cart hold TTL: hours a held cart remains valid before it expires (default: 24)
CART_HOLD_TTL_HOURS=24

# Reporting: debounce window (seconds) between SaleCreated-driven materialized
# view refreshes. Many sales within the window coalesce into a single refresh
# (default: 30)
REPORT_REFRESH_DEBOUNCE=30

# Logging settings
# ENV controls log format: "development" (text) vs "production" (JSON). Defaults to development.
# Set this so the startup warning about a missing ENV is not logged.
ENV=development
# LOG_LEVEL: debug | info | warn | error (default: debug in development, info in production)
LOG_LEVEL=info
# Frontend dev server port (Vite)
FRONTEND_PORT=5173
# Backend dev server port (Go)
BACKEND_PORT=9095
# Development database port (postgres-dev container)
DATABASE_PORT=5433

# Receipt printing
# Mode used by the POS after a sale:
#   preview - show the 58mm on-screen overlay and the browser print dialog (default)
#   silent  - POST the receipt to the local print agent (tools/print-agent) which
#             routes it to a 58mm thermal printer / virtual printer / file, no dialog
# The print agent runs separately: `cd tools/print-agent && PRINT_TRANSPORT=file go run ./cmd/print-agent`
# Per-register overrides are also configurable from the POS UI (gear icon by Print).
VITE_PRINT_MODE=preview
VITE_PRINT_AGENT_URL=http://localhost:9123
